# MongoDB Configuration
MONGODB_URI=mongodb://mongodb:27017/eirene

# Redis Configuration (NEW)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_TTL=3600

# JWT Configuration
JWT_SECRET=eirene-jwt-secret-key-change-in-production-2025-phase3
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=7

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=200
OPENAI_TEMPERATURE=0.7

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Service URLs
AUTH_SERVICE_URL=http://auth-service:5001
MOOD_SERVICE_URL=http://mood-service:5002
CREATIVE_THERAPY_SERVICE_URL=http://creative-therapy-service:5003
NOTIFICATION_SERVICE_URL=http://notification-service:5004
ANALYTICS_SERVICE_URL=http://analytics-service:5005
AI_ENGINE_URL=http://ai-engine:5006
RESOURCE_FINDER_URL=http://resource-finder:5007
PRIVACY_SERVICE_URL=http://privacy-service:5008
MULTILINGUAL_SERVICE_URL=http://multilingual-service:5009

# Encryption Configuration (NEW)
ENCRYPTION_KEY=your-32-byte-base64-encryption-key-here
ENCRYPTION_ALGORITHM=AES-256-CBC
SENSITIVE_FIELDS=mood_text,voice_emotion,ai_response

# Privacy & Data Retention (NEW)
DATA_RETENTION_DAYS=730
ANONYMIZATION_ENABLED=true
ALLOW_DATA_EXPORT=true
ALLOW_ACCOUNT_DELETE=true

# Prediction Configuration (NEW)
PREDICTION_HORIZON_DAYS=7
MIN_HISTORY_FOR_PREDICTION=7
PREDICTION_UPDATE_INTERVAL=86400

# Personalization Configuration (NEW)
USER_CONTEXT_HISTORY_LIMIT=10
COUNSELOR_TONE_ADAPTIVE=true
MEMORY_CACHE_ENABLED=true

# Multilingual Configuration (NEW)
SUPPORTED_LANGUAGES=en,hi,hi-en
DEFAULT_LANGUAGE=hi-en
AUTO_DETECT_LANGUAGE=true
TRANSLATION_API=google

# Crisis Detection (NEW)
CRISIS_KEYWORDS=suicide,kill myself,end it all,no reason to live
CRISIS_THRESHOLD=0.8
AUTO_TRIGGER_RESOURCES=true

# Application Configuration
APP_NAME=Eirene AI Mental Wellness Platform
APP_VERSION=3.0.0
APP_PHASE=3
APP_URL=http://localhost:5000

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Development Settings
CORS_ORIGINS=*
LOG_LEVEL=INFO
